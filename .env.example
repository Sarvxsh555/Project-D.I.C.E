# =====================================================================
# D.I.C.E — environment template (local run, no Docker)
# Copy to `.env` and adjust. `.env` is gitignored; never commit secrets.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# MySQL — must already be running locally (MySQL 8.0+).
# Create the database and a dedicated user before first run, e.g.:
#   CREATE DATABASE dice CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'dice'@'localhost' IDENTIFIED BY 'dice_local_pw';
#   GRANT ALL PRIVILEGES ON dice.* TO 'dice'@'localhost';
# ---------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dice?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=dice
SPRING_DATASOURCE_PASSWORD=dice_local_pw

# ---------------------------------------------------------------------
# Backend (Spring Boot) — run with: cd backend && ./mvnw spring-boot:run
# ---------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# HS256 signing key. MUST be >= 32 bytes. Generate a real one with:
#   openssl rand -base64 48
DICE_SECURITY_JWT_SECRET=dev-only-insecure-secret-change-me-at-least-32-bytes-long
DICE_SECURITY_JWT_EXPIRATION_MS=86400000

# Comma-separated origins allowed to call the API.
DICE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Odoo integration
# Leave ODOO_ENABLED=false to run fully on the OEEG emulator (demo mode).
# ---------------------------------------------------------------------
DICE_ODOO_ENABLED=false
DICE_ODOO_URL=http://localhost:8069
DICE_ODOO_DB=odoo
DICE_ODOO_USERNAME=admin
DICE_ODOO_API_KEY=
# Shared secret the webhook caller must present in X-Odoo-Signature.
DICE_ODOO_WEBHOOK_SECRET=dev-webhook-secret

# ---------------------------------------------------------------------
# OEEG — Odoo Event Emulation Gateway (event generator / scenario runner)
# Run with: cd oeeg && ./mvnw spring-boot:run
# ---------------------------------------------------------------------
OEEG_TARGET_URL=http://localhost:8080/api/webhooks/odoo
OEEG_WEBHOOK_SECRET=dev-webhook-secret
OEEG_EMIT_DELAY_MS=750

# ---------------------------------------------------------------------
# Frontend (Vite — only VITE_* vars reach the browser bundle)
# Run with: cd frontend && npm run dev
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

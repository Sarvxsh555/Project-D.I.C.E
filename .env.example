# =====================================================================
# D.I.C.E — environment template
# Copy to `.env` and adjust. `.env` is gitignored; never commit secrets.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# MySQL (consumed by the `mysql` service in docker-compose.yml and host backend)
# ---------------------------------------------------------------------
MYSQL_DATABASE=dealflow360
MYSQL_USER=dice
MYSQL_PASSWORD=dice
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# ---------------------------------------------------------------------
# Backend (Spring Boot)
# ---------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Inside docker-compose the host is the service name `mysql`.
# Running the backend on the host directly? Use localhost.
DB_HOST=localhost
DB_PORT=3306

# HS256 signing key. MUST be >= 32 bytes.
JWT_SECRET=dev-only-insecure-secret-change-me-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Odoo integration
# Leave ODOO_ENABLED=false to run fully on the OEEG emulator (demo mode).
# ---------------------------------------------------------------------
ODOO_ENABLED=false
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_API_KEY=
# Shared secret the webhook caller must present in X-Odoo-Signature.
ODOO_WEBHOOK_SECRET=dev-webhook-secret

# ---------------------------------------------------------------------
# OEEG — Odoo Event Emulation Gateway (event generator / scenario runner)
# ---------------------------------------------------------------------
OEEG_PORT=8081
# Where OEEG posts generated events. Service name inside compose.
OEEG_TARGET_URL=http://backend:8080/api/webhooks/odoo
# Delay between events when replaying a scenario.
OEEG_EMIT_DELAY_MS=750

# ---------------------------------------------------------------------
# Frontend (Vite — only VITE_* vars reach the browser bundle)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api

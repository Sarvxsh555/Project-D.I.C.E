PORT=8086
DATABASE_URL=postgres://loginuser:loginpass@localhost:5433/dealflow
JWT_SECRET=change-this-demo-secret-key-please-32-bytes-min
QUOTATION_SERVICE_BASE_URL=http://localhost:8082/api
APPROVAL_SERVICE_BASE_URL=http://localhost:8085/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# Largest customer concession (discount percentage points) that may keep an already-APPROVED
# quote approved instead of tearing down the approval and re-queuing it for a human. The
# margin floor guard is read from the shared governance_threshold table, not from here.
NEGOTIATION_AUTO_ACCEPT_POINTS=2

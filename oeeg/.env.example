DICE_WEBHOOK_URL=http://localhost:8082/api/webhooks/odoo
OEEG_WEBHOOK_KEY=oeeg-demo-key
PORT=8092
# Live Odoo JSON-RPC (off for the hackathon demo)
DICE_ODOO_ENABLED=false
# ODOO_URL=https://your-instance.odoo.com
# ODOO_DB=yourdb
# ODOO_USERNAME=api
# ODOO_API_KEY=

# Background poller. Off by default; nothing polls unless this is true.
# With DICE_ODOO_ENABLED=true it asks Odoo for records changed since the last watermark;
# otherwise it replays the listed scenarios so the ingest path runs unattended.
OEEG_POLL_ENABLED=false
OEEG_POLL_INTERVAL_MS=60000
OEEG_POLL_SCENARIOS=stock.replenished
# Optionally tie emitted events to a specific quote/order:
# OEEG_POLL_QUOTATION_ID=1
# OEEG_POLL_ORDER_ID=1
